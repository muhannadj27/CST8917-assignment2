### CST8917 Assignment 2 — Version A: Durable Functions
### Expense Approval Workflow — test scenarios
### Use with the VS Code "REST Client" extension.
### Run `func start` first, then fire requests top to bottom.

@baseUrl = http://localhost:7071/api

### ============================================================
### Scenario 1: Valid expense under $100 -> Auto-approved
### ============================================================
POST {{baseUrl}}/expenses
Content-Type: application/json

{
  "employeeName": "Alice Chen",
  "employeeEmail": "alice.chen@example.com",
  "amount": 45.50,
  "category": "supplies",
  "description": "Notebooks and pens for the team",
  "managerEmail": "manager1@example.com"
}

### Check status (replace {instanceId} with the id returned above, or use
### the statusQueryGetUri returned in the response body directly)
# GET {{baseUrl}}/expenses/{instanceId}/status
# GET <statusQueryGetUri from previous response>


### ============================================================
### Scenario 2: Valid expense >= $100, manager approves -> Approved
### ============================================================
POST {{baseUrl}}/expenses
Content-Type: application/json

{
  "employeeName": "Bilal Karim",
  "employeeEmail": "bilal.karim@example.com",
  "amount": 350.00,
  "category": "travel",
  "description": "Flight to client site",
  "managerEmail": "manager1@example.com"
}

### Copy the instanceId from the response above into the URL below,
### then send this request BEFORE the 5-minute timeout elapses.
POST {{baseUrl}}/expenses/PASTE_INSTANCE_ID_HERE/decision
Content-Type: application/json

{
  "decision": "approved",
  "comment": "Looks good, approved."
}


### ============================================================
### Scenario 3: Valid expense >= $100, manager rejects -> Rejected
### ============================================================
POST {{baseUrl}}/expenses
Content-Type: application/json

{
  "employeeName": "Carla Diaz",
  "employeeEmail": "carla.diaz@example.com",
  "amount": 899.99,
  "category": "equipment",
  "description": "New monitor",
  "managerEmail": "manager1@example.com"
}

### Copy instanceId from above into the URL below
POST {{baseUrl}}/expenses/PASTE_INSTANCE_ID_HERE/decision
Content-Type: application/json

{
  "decision": "rejected",
  "comment": "Not approved this quarter, budget frozen."
}


### ============================================================
### Scenario 4: Valid expense >= $100, no manager response -> Escalated
### Do NOT send a /decision request for this instance.
### Wait MANAGER_RESPONSE_TIMEOUT_MINUTES (default 5 min) and then
### poll the status endpoint to see status="approved", escalated=true.
### ============================================================
POST {{baseUrl}}/expenses
Content-Type: application/json

{
  "employeeName": "Deepa Nair",
  "employeeEmail": "deepa.nair@example.com",
  "amount": 500.00,
  "category": "software",
  "description": "Annual IDE license",
  "managerEmail": "manager1@example.com"
}

### Poll this after ~5 minutes using the statusQueryGetUri from the response above
# GET <statusQueryGetUri from previous response>


### ============================================================
### Scenario 5: Missing required fields -> Validation error
### ============================================================
POST {{baseUrl}}/expenses
Content-Type: application/json

{
  "employeeName": "Evan Wright",
  "amount": 75,
  "category": "meals",
  "description": "Team lunch"
}

### Missing employeeEmail and managerEmail.
### Poll status -> expect status="validation_error"


### ============================================================
### Scenario 6: Invalid category -> Validation error
### ============================================================
POST {{baseUrl}}/expenses
Content-Type: application/json

{
  "employeeName": "Fiona Lee",
  "employeeEmail": "fiona.lee@example.com",
  "amount": 120,
  "category": "entertainment",
  "description": "Client dinner",
  "managerEmail": "manager1@example.com"
}

### "entertainment" is not in the valid category list.
### Poll status -> expect status="validation_error"
